#!/usr/bin/env python3
"""Local staging GUI for bin/archive.

Serves a two-column board on 127.0.0.1 where repos are staged as Keep or
Archive. Committing the plan streams the transfers one repo at a time; any repo
that trips a review rule is held in the queue until it gets a decision, while
the rest keep moving.

Nothing here talks to anything but the GitHub API via `gh`, and the socket is
bound to loopback only.
"""

import json
import os
import queue
import re
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request
import webbrowser
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
UI_HTML = Path(__file__).resolve().parent / "ui.html"
PLAN_PATH = ROOT / "plan.json"
NOTES_PATH = ROOT / "notes.json"

# Repos that must never leave the main account, whatever the board says.
PROTECTED = set()


def load_config():
    cfg = {
        "SOURCE_OWNER": "",
        "ARCHIVE_OWNER": "",
        "STALE_DAYS": "365",
        "CODE_DIR": str(Path.home() / "Code"),
        "SELF_REPO": "archive",
    }
    rc = ROOT / ".archiverc"
    if rc.exists():
        for line in rc.read_text().splitlines():
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, v = line.split("=", 1)
            cfg[k.strip()] = v.strip()
    for k in cfg:
        if os.environ.get(k):
            cfg[k] = os.environ[k]
    return cfg


CFG = load_config()
SOURCE = CFG["SOURCE_OWNER"]
ARCHIVE = CFG["ARCHIVE_OWNER"]
SELF_REPO = CFG["SELF_REPO"]
CODE_DIR = Path(CFG["CODE_DIR"])
PROTECTED = {SELF_REPO, SOURCE, f"{SOURCE}.github.io"}


# ----------------------------------------------------------------- gh glue --

def gh(args, check=True):
    p = subprocess.run(["gh", *args], capture_output=True, text=True)
    if check and p.returncode != 0:
        raise RuntimeError(p.stderr.strip() or f"gh {' '.join(args)} failed")
    return p.stdout


def gh_json(args, check=True):
    out = gh(args, check=check)
    return json.loads(out) if out.strip() else None


def list_repos(owner):
    fields = ("name,description,isPrivate,isFork,isArchived,stargazerCount,"
              "forkCount,pushedAt,primaryLanguage,diskUsage")
    return gh_json(["repo", "list", owner, "--limit", "1000", "--json", fields])


# ---------------------------------------------------------- review scanning --

def _registry_repo_url(payload, registry):
    """Where the registry says the package's source lives."""
    if registry == "crates.io":
        c = payload.get("crate", {})
        return c.get("repository") or c.get("homepage") or ""
    repo = payload.get("repository")
    if isinstance(repo, dict):
        return repo.get("url", "")
    return repo or payload.get("homepage") or ""


def _manifest_package_name(text, path):
    if path == "Cargo.toml":
        m = re.search(r'^\s*name\s*=\s*"([^"]+)"', text, re.M)
        return m.group(1) if m else None
    try:
        name = json.loads(text).get("name")
    except (json.JSONDecodeError, AttributeError):
        return None
    return name if name and not name.startswith(".") else None


def published_to_registry(repo):
    """Flag only if a registry entry actually points back at *this* repo.

    Matching on package name alone gives false positives — plenty of common
    names are already taken by other people.
    """
    import base64

    for path, url, registry in (
        ("Cargo.toml", "https://crates.io/api/v1/crates/{}", "crates.io"),
        ("package.json", "https://registry.npmjs.org/{}", "npm"),
    ):
        raw = gh(["api", f"repos/{SOURCE}/{repo}/contents/{path}",
                  "--jq", ".content"], check=False).strip()
        if not raw:
            continue
        try:
            text = base64.b64decode(raw).decode("utf-8", "replace")
        except Exception:
            continue
        pkg = _manifest_package_name(text, path)
        if not pkg:
            continue

        req = urllib.request.Request(url.format(pkg),
                                     headers={"User-Agent": "archive-tool"})
        try:
            with urllib.request.urlopen(req, timeout=8) as r:
                if r.status != 200:
                    continue
                payload = json.load(r)
        except (urllib.error.HTTPError, urllib.error.URLError,
                TimeoutError, json.JSONDecodeError):
            continue

        source = _registry_repo_url(payload, registry).lower()
        if f"{SOURCE}/{repo}".lower() not in source:
            continue                      # someone else owns that package name
        return f"published to {registry} as {pkg}"
    return None


def review_flags(repo, meta):
    """Reasons a human should look before this one moves. Empty means go."""
    flags = []
    if repo in PROTECTED:
        flags.append("protected repo — should stay on the main account")

    if meta.get("stargazerCount", 0) >= 5:
        flags.append(f"{meta['stargazerCount']} stars — archiving blocks new PRs")

    full = gh_json(["api", f"repos/{SOURCE}/{repo}"], check=False)
    if full:
        if full.get("has_pages"):
            site = full.get("homepage") or f"{SOURCE}.github.io/{repo}"
            flags.append(f"serves GitHub Pages ({site}) — deploys stop running")
        if full.get("fork") and full.get("parent"):
            pass  # forks are safe; upstream is the real thing

    issues = gh_json(["api", f"repos/{SOURCE}/{repo}/issues",
                      "--method", "GET", "-f", "state=open", "-f", "per_page=30"],
                     check=False) or []
    others = {i["user"]["login"] for i in issues
              if i.get("user", {}).get("login", "").lower() != SOURCE.lower()
              and not i.get("user", {}).get("login", "").endswith("[bot]")}
    if others:
        who = ", ".join(sorted(others)[:3])
        flags.append(f"open issues/PRs from {who} — archiving freezes them")

    pub = published_to_registry(repo)
    if pub:
        flags.append(pub + " — the repo link is the crate's homepage")

    return flags


# ------------------------------------------------------------- move machine --

class Run:
    """One execution of a staged plan. Events go out over SSE."""

    def __init__(self):
        self.lock = threading.Lock()
        self.subscribers = []
        self.active = False
        self.items = {}          # repo -> {"state": ..., "flags": [...], ...}
        self.order = []
        self.decisions = queue.Queue()
        self.reason = ""
        self.thread = None

    # -- event plumbing --
    def subscribe(self):
        q = queue.Queue()
        with self.lock:
            self.subscribers.append(q)
            snapshot = {"type": "snapshot", "items": self.snapshot(),
                        "active": self.active}
        q.put(snapshot)
        return q

    def unsubscribe(self, q):
        with self.lock:
            if q in self.subscribers:
                self.subscribers.remove(q)

    def emit(self, event):
        with self.lock:
            subs = list(self.subscribers)
        for q in subs:
            q.put(event)

    def snapshot(self):
        return [dict(self.items[r], repo=r) for r in self.order]

    def set_state(self, repo, state, **extra):
        with self.lock:
            self.items[repo].update(state=state, **extra)
            payload = dict(self.items[repo], repo=repo)
        self.emit({"type": "item", "item": payload})

    # -- the run itself --
    def start(self, repos, reason):
        if self.active:
            return False
        self.reason = reason
        self.order = list(repos)
        self.items = {r: {"state": "queued", "flags": [], "note": ""}
                      for r in repos}
        self.active = True
        self.thread = threading.Thread(target=self._work, daemon=True)
        self.thread.start()
        return True

    def _work(self):
        held = []
        for repo in self.order:
            if self.items[repo]["state"] != "queued":
                continue
            self._process(repo, held)

        # Second pass: anything held waits here for a decision from the board.
        while held:
            self.emit({"type": "awaiting", "count": len(held)})
            repo, action = self.decisions.get()
            if repo not in held:
                continue
            held.remove(repo)
            if action == "archive":
                self._transfer(repo)
            else:
                self.set_state(repo, "kept", note="kept after review")

        with self.lock:
            self.active = False
        self._reindex()
        self.emit({"type": "done", "items": self.snapshot()})

    def _process(self, repo, held):
        self.set_state(repo, "checking")
        try:
            flags = review_flags(repo, self.meta.get(repo, {}))
        except Exception as e:                       # a check failing is itself
            flags = [f"could not complete review checks: {e}"]
        if flags:
            held.append(repo)
            self.set_state(repo, "held", flags=flags)
            return
        self._transfer(repo)

    def _transfer(self, repo):
        self.set_state(repo, "moving")
        if repo in PROTECTED:
            self.set_state(repo, "failed", note="refused: protected repo")
            return
        p = subprocess.run(
            ["gh", "api", "-X", "POST", f"repos/{SOURCE}/{repo}/transfer",
             "-f", f"new_owner={ARCHIVE}", "--silent"],
            capture_output=True, text=True)
        if p.returncode != 0:
            err = (p.stderr or "").strip().splitlines()
            self.set_state(repo, "failed", note=err[-1] if err else "transfer failed")
            return

        for _ in range(30):                     # transfers are asynchronous
            if subprocess.run(["gh", "api", f"repos/{ARCHIVE}/{repo}"],
                              capture_output=True).returncode == 0:
                break
            time.sleep(2)
        else:
            self.set_state(repo, "failed", note="transfer not visible after 60s")
            return

        subprocess.run(["gh", "api", "-X", "PATCH", f"repos/{ARCHIVE}/{repo}",
                        "-F", "archived=true", "--silent"], capture_output=True)
        self._write_note(repo)
        self._repoint(repo)
        self.set_state(repo, "moved", note=f"{ARCHIVE}/{repo}")

    def _write_note(self, repo):
        notes = {}
        if NOTES_PATH.exists():
            try:
                notes = json.loads(NOTES_PATH.read_text())
            except json.JSONDecodeError:
                notes = {}
        notes[repo] = {"reason": self.reason,
                       "archived_at": time.strftime("%Y-%m-%dT%H:%M:%SZ",
                                                    time.gmtime())}
        NOTES_PATH.write_text(json.dumps(notes, indent=2, sort_keys=True) + "\n")

    def _repoint(self, repo):
        d = CODE_DIR / repo
        if not (d / ".git").is_dir():
            return
        url = subprocess.run(["git", "-C", str(d), "remote", "get-url", "origin"],
                             capture_output=True, text=True).stdout.strip()
        if f"{SOURCE}/{repo}" not in url:
            return
        subprocess.run(["git", "-C", str(d), "remote", "set-url", "origin",
                        url.replace(f"{SOURCE}/{repo}", f"{ARCHIVE}/{repo}")],
                       capture_output=True)

    def _reindex(self):
        subprocess.run([str(ROOT / "bin" / "archive"), "index"],
                       capture_output=True)

    def decide(self, repo, action):
        self.decisions.put((repo, action))


RUN = Run()
RUN.meta = {}


# ------------------------------------------------------------------ server --

class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *a):
        pass

    def _send(self, code, body, ctype="application/json"):
        raw = body if isinstance(body, bytes) else body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(raw)))
        self.end_headers()
        self.wfile.write(raw)

    def do_GET(self):
        if self.path == "/":
            return self._send(200, UI_HTML.read_bytes(), "text/html; charset=utf-8")
        if self.path == "/api/state":
            return self._send(200, json.dumps(self.state()))
        if self.path == "/api/events":
            return self.events()
        self._send(404, json.dumps({"error": "not found"}))

    def do_POST(self):
        n = int(self.headers.get("Content-Length", 0))
        body = json.loads(self.rfile.read(n) or "{}")
        if self.path == "/api/plan":
            PLAN_PATH.write_text(json.dumps(body, indent=2) + "\n")
            return self._send(200, json.dumps({"ok": True}))
        if self.path == "/api/run":
            repos = [r for r in body.get("archive", []) if r not in PROTECTED]
            ok = RUN.start(repos, body.get("reason", ""))
            return self._send(200 if ok else 409, json.dumps({"ok": ok}))
        if self.path == "/api/decide":
            RUN.decide(body["repo"], body["action"])
            return self._send(200, json.dumps({"ok": True}))
        self._send(404, json.dumps({"error": "not found"}))

    def state(self):
        repos = list_repos(SOURCE)
        RUN.meta = {r["name"]: r for r in repos}
        plan = {}
        if PLAN_PATH.exists():
            try:
                plan = json.loads(PLAN_PATH.read_text())
            except json.JSONDecodeError:
                plan = {}
        return {
            "source": SOURCE,
            "archive": ARCHIVE,
            "protected": sorted(PROTECTED),
            "staleDays": int(CFG["STALE_DAYS"]),
            "repos": repos,
            "plan": plan,
            "running": RUN.active,
        }

    def events(self):
        q = RUN.subscribe()
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream")
        self.send_header("Cache-Control", "no-cache")
        self.send_header("Connection", "keep-alive")
        self.end_headers()
        try:
            while True:
                try:
                    ev = q.get(timeout=15)
                    self.wfile.write(f"data: {json.dumps(ev)}\n\n".encode())
                except queue.Empty:
                    self.wfile.write(b": keepalive\n\n")
                self.wfile.flush()
        except (BrokenPipeError, ConnectionResetError):
            pass
        finally:
            RUN.unsubscribe(q)


def main():
    for dep in ("gh",):
        if subprocess.run(["which", dep], capture_output=True).returncode != 0:
            sys.exit(f"{dep} is not installed")
    if not SOURCE or not ARCHIVE:
        sys.exit("SOURCE_OWNER and ARCHIVE_OWNER must be set in .archiverc")

    port = int(os.environ.get("ARCHIVE_UI_PORT", "8787"))
    srv = ThreadingHTTPServer(("127.0.0.1", port), Handler)
    url = f"http://127.0.0.1:{port}"
    print(f"archive board → {url}   (ctrl-c to stop)")
    if "--no-open" not in sys.argv:
        threading.Timer(0.6, lambda: webbrowser.open(url)).start()
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        print("\nstopped")


if __name__ == "__main__":
    main()
